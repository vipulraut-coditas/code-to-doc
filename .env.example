# Copy to .env (in the folder where you run `codedoc`) and fill in ONLY the key you use.
# .env is git-ignored - never commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Any OpenAI-compatible endpoint (OpenRouter, LM Studio, vLLM, ...)
CODEDOC_COMPAT_API_KEY=

# Optional overrides of the saved settings (useful in CI)
# CODEDOC_BACKEND=api            # api | claude-code
# CODEDOC_PROVIDER=anthropic
# CODEDOC_FAST_MODEL=claude-haiku-5-5
# CODEDOC_SMART_MODEL=claude-sonnet-5-5
# CODEDOC_BASE_URL=
